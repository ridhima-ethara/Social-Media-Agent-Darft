node_modules/
dist/
dist-ssr/
build/

# env
.env
.env.local
.env.*.local
server/.env
# Every server-side env overlay — server/.env.apify holds a paid API token.
# Ignored by pattern rather than by name so a future overlay cannot be committed
# by someone who forgets to add it here. The tracked example stays visible.
server/.env.*
!server/.env.example
# CREDENTIALS. server/secrets.env holds every API token the server reads.
# Ignored by prefix so secrets.env.bak, secrets.env.old and any copy someone
# makes while rotating a key are covered too — the example is the one exception.
server/secrets.env*
!server/secrets.env.example
# Key material — service-account JSON and anything else dropped beside it.
server/secrets/

# logs
*.log
npm-debug.log*
logs/

# editor/os
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# build artifacts
*.tsbuildinfo
.cache/

# misc
coverage/
.turbo/

# ── Python tiers are LOCAL ENVIRONMENTS ──────────────────────────────────────
# backend/.venv holds the agent runtime and crawl4ai; .mflux-venv holds the MLX
# image stack. Both are recreated from backend/requirements.txt and the README,
# and both are far too large to version.
backend/.venv/
.mflux-venv/
__pycache__/
*.pyc

# ── Runtime skills are a BUILD ARTIFACT ──────────────────────────────────────
# packages/skills/ is the versioned source of truth. scripts/build-skills.ts
# copies it here at build time, and the runtime process runs with cwd set to
# packages/runtime/ so the Agent SDK finds them. Never edit, never commit.
packages/runtime/.claude/

# Operator-supplied reference material. The folder and its README are tracked;
# the source documents are not — they are inputs, often large and often private.
corpus/*
!corpus/README.md

# Personal Claude Code settings — MCP approvals and local overrides.
# Not shared: approving a project-scoped MCP server is a per-person trust
# decision, and committing it would approve it for everyone who clones.
.claude/settings.local.json
