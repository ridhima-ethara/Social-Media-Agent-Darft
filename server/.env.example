# ── Core ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ethara:ethara@localhost:5432/ethara_sma
PORT=4000
WORKSPACE_SLUG=ethara
CORS_ORIGIN=*
TZ=Asia/Kolkata
# 'demo' simulates every platform call. 'live' requires real credentials.
PUBLISH_MODE=demo

# ── Ethara · command plane ───────────────────────────────────────────────
# The reasoning model behind intent parsing, planning and narration.
# Leave ASSISTANT_MODEL_PROVIDER blank (or 'deterministic') and Ethara runs on the
# built-in grammar parser + template narrator: slightly blunter, fully working.
ASSISTANT_MODEL_PROVIDER=            # gcp | ollama | deterministic
ASSISTANT_PLANNER_MODEL=gemini-2.5-pro
ASSISTANT_NARRATOR_MODEL=gemini-2.5-flash
ASSISTANT_MAX_PLAN_STEPS=8
ASSISTANT_CONFIRM_TTL_SECONDS=180
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_BRIEF_CRON=0 9 * * 1-5     # weekday 09:00 proactive briefing
ASSISTANT_WATCH_INTERVAL_MS=60000    # ambient anomaly sweep
ASSISTANT_VOICE_ENABLED=true         # server hint only; the browser decides
ASSISTANT_ADDRESS_STYLE=surname      # surname | firstname | role

# ── SCRAPING · Apify (LinkedIn) ──────────────────────────────────────────
# Blank APIFY_API_TOKEN ⇒ the bundled offline LinkedIn fixture corpus.
# Token: https://console.apify.com/settings/integrations — sent as
# `Authorization: Bearer`, never in the query string (https://apify.com/agents.md).
# Inspect any actor's input schema by appending .md to its Store URL, e.g.
# https://apify.com/harvestapi/linkedin-post-search.md
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
# Keyword search AND hashtag feeds ("#tag" is a search query). Pay-per-result.
APIFY_LINKEDIN_POSTS_ACTOR=harvestapi~linkedin-post-search
APIFY_LINKEDIN_HASHTAG_ACTOR=harvestapi~linkedin-post-search
# Competitor company pages and profiles, by URL.
APIFY_LINKEDIN_PROFILE_ACTOR=harvestapi~linkedin-company-posts
APIFY_RUN_TIMEOUT_MS=180000
APIFY_MAX_ITEMS_PER_KEYWORD=50
APIFY_MEMORY_MBYTES=1024

# ── KNOWLEDGE · Parallel Web Systems (deep research) ─────────────────────
# Blank PARALLEL_API_KEY ⇒ the bundled research fixtures.
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_SEARCH_PATH=/v1beta/search
PARALLEL_TASK_PATH=/v1/tasks/runs
PARALLEL_PROCESSOR=base
PARALLEL_MAX_RESULTS=10
PARALLEL_MAX_CHARS_PER_RESULT=6000
PARALLEL_TIMEOUT_MS=120000
KNOWLEDGE_BUILD_CRON=0 6 * * 0    # Sunday 06:00 in TZ
KNOWLEDGE_HASHTAG_COUNT=25

# ── CONTENT · Google Cloud (Gemini / Vertex / Imagen) ────────────────────
# Blank ⇒ the deterministic template writer. Never blocks the pipeline.
GCP_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON=
GCP_TEXT_MODEL=gemini-2.5-pro
GCP_FAST_TEXT_MODEL=gemini-2.5-flash
GCP_IMAGE_MODEL=imagen-4.0-generate-001
GCP_TIMEOUT_MS=90000
GCP_MAX_OUTPUT_TOKENS=2048
GCP_TEMPERATURE=0.6

# ── LOCAL MODELS · Ollama (Qwen3 text, FLUX.2 Klein images) ──────────────
# Blank OLLAMA_BASE_URL ⇒ Ollama is treated as absent. There is no default on
# purpose: a default would make /health claim a live local model on a machine
# with no daemon running.
#   ollama serve
#   ollama pull qwen3:14b
OLLAMA_BASE_URL=                     # e.g. http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3:14b
OLLAMA_FAST_TEXT_MODEL=qwen3:14b
OLLAMA_IMAGE_MODEL=x/flux2-klein:9b
OLLAMA_TIMEOUT_MS=180000             # local generation is slower per token
OLLAMA_IMAGE_TIMEOUT_MS=600000
OLLAMA_CONTEXT_TOKENS=16384          # Qwen3-14B ships a 40 960 window

# Which vendor writes captions, phrases calendar ideas and rewrites drafts.
# 'auto' prefers a configured local model over the hosted one.
TEXT_MODEL_PROVIDER=auto             # auto | ollama | gcp

# ── IMAGE MODEL · FLUX.2 Klein on MLX (mflux) ────────────────────────────
# Ollama 0.33.3 refuses image models over HTTP — `/api/generate` answers
# "image generation models are not currently supported" — so mflux is the
# transport that actually paints. The painter tries Ollama first regardless,
# and will switch over on its own once Ollama exposes image generation.
#   python3.12 -m venv .mflux-venv && .mflux-venv/bin/pip install mflux==0.19.1
# MFLUX_PYTHON must point at that venv's interpreter; the CLI is found beside it.
MFLUX_PYTHON=                        # e.g. /abs/path/.mflux-venv/bin/python
# flux2-klein-4b is Apache-2.0 and ungated. flux2-klein-9b is a gated
# Hugging Face repo under the FLUX non-commercial licence: accept the terms and
# set HF_TOKEN before naming it here.
MFLUX_MODEL=flux2-klein-4b
MFLUX_STEPS=4                        # Klein is distilled; four steps is the point
MFLUX_SEED=42                        # fixed, so a brief renders the same twice
MFLUX_QUANTIZE=8
MFLUX_TIMEOUT_MS=900000              # the first run also downloads weights

# ── SCRAPING · crawl4ai (keyless open web) ───────────────────────────────
# Tier 2 of the capture chain: Apify → crawl4ai → the bundled corpus. With no
# Apify token, keywords still get real live evidence instead of fixtures.
#   backend/.venv/bin/pip install -r backend/requirements.txt
#   backend/.venv/bin/python -m playwright install chromium
CRAWL4AI_PYTHON=                     # e.g. /abs/path/backend/.venv/bin/python
CRAWL4AI_SEARCH_ENGINES=duckduckgo,bing
CRAWL4AI_MAX_PAGES_PER_KEYWORD=6
CRAWL4AI_MAX_CHARS_PER_PAGE=6000
CRAWL4AI_TIMEOUT_MS=180000
CRAWL4AI_DELAY_MS=400                # politeness between fetches
CRAWL4AI_HEADLESS=true

# ── IMAGE MODEL (optional secondary renderer) ────────────────────────────
Z_IMAGE_ENDPOINT=
Z_IMAGE_API_KEY=
Z_IMAGE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo
Z_IMAGE_TIMEOUT_MS=60000
