# ── Core ─────────────────────────────────────────────────────────────────
# `ethara_socialai` is what docker-compose.yml creates (POSTGRES_DB), and what
# config.ts defaults to. The three agree deliberately: they used to say
# `ethara_sma` here, so copying this file gave you a URL pointing at a database
# nothing had created, and the API refused to start without explaining why.
DATABASE_URL=postgresql://ethara:ethara@localhost:5432/ethara_socialai
# 4001, not 4000: another project answers on :4000 with a different API. The Vite
# dev proxy and the container's nginx both read this same port.
PORT=4001
WORKSPACE_SLUG=ethara
CORS_ORIGIN=*
TZ=Asia/Kolkata
# 'demo' simulates every platform call. 'live' requires real credentials.
# LinkedIn is the only lane with a live connector; the other three refuse in live mode.
PUBLISH_MODE=demo

# ── Publishing · Buffer ──────────────────────────────────────────────────
# Every platform publishes through Buffer. Connect the channels inside Buffer,
# create an API key (profile icon → Settings → API), and set the token in
# server/secrets.env. Company Pages work here, which they cannot via a direct
# LinkedIn app without their reviewed Community Management access.
BUFFER_ACCESS_TOKEN=            # → server/secrets.env
# Optional. Only needed when one service has two connected channels.
BUFFER_PROFILE_ID_LINKEDIN=
BUFFER_PROFILE_ID_INSTAGRAM=
BUFFER_PROFILE_ID_X=
BUFFER_PROFILE_ID_FACEBOOK=
BUFFER_API_BASE=https://api.buffer.com   # GraphQL. The legacy REST host rejects current keys.
BUFFER_TIMEOUT_MS=30000



# ── Ethara · command plane ───────────────────────────────────────────────
# The reasoning model behind intent parsing, planning and narration.
# Leave ASSISTANT_MODEL_PROVIDER blank (or 'deterministic') and Ethara runs on the
# built-in grammar parser + template narrator: slightly blunter, fully working.
ASSISTANT_MODEL_PROVIDER=            # gcp | deterministic
ASSISTANT_PLANNER_MODEL=gemini-2.5-pro
ASSISTANT_NARRATOR_MODEL=gemini-2.5-flash
ASSISTANT_MAX_PLAN_STEPS=8
ASSISTANT_CONFIRM_TTL_SECONDS=180
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_BRIEF_CRON=0 9 * * 1-5     # weekday 09:00 proactive briefing
ASSISTANT_WATCH_INTERVAL_MS=60000    # ambient anomaly sweep
ASSISTANT_VOICE_ENABLED=true         # server hint only; the browser decides
ASSISTANT_ADDRESS_STYLE=surname      # surname | firstname | role

# ── KNOWLEDGE · Parallel Web Systems (deep research — NOT scraping) ─────
# Used only by the Knowledge Agent's hashtag research. Every Scraping Agent lane
# is the Claude Bridge; Parallel is not a capture source. Blank ⇒ Knowledge Base
# builds find nothing citable and say so — there is no bundled research corpus.
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_SEARCH_PATH=/v1beta/search
PARALLEL_TASK_PATH=/v1/tasks/runs
PARALLEL_PROCESSOR=base
PARALLEL_MAX_RESULTS=10
PARALLEL_MAX_CHARS_PER_RESULT=6000
PARALLEL_TIMEOUT_MS=120000
# Discovery on a timer. BLANK MEANS NOT SCHEDULED — a run costs Claude usage and
# several minutes of crawling, so it is opted into rather than started by
# installing the product. What it captures comes from the weekly keyword rota
# (shared/keyword-schedule.ts); this only decides when.
DISCOVERY_CRON=                   # e.g. 0 7 * * 1-5 for weekdays 07:00 in TZ
COMPETITOR_MONITOR_CRON=          # e.g. 0 6 * * * — profiles competitors due by their monitoring frequency

KNOWLEDGE_BUILD_CRON=0 6 * * 0    # Sunday 06:00 in TZ
KNOWLEDGE_HASHTAG_COUNT=25

# ── CONTENT · Google Cloud (Gemini / Vertex / Imagen) ────────────────────
# Blank ⇒ the deterministic template writer. Never blocks the pipeline.
GCP_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON=
GCP_TEXT_MODEL=gemini-2.5-pro
GCP_FAST_TEXT_MODEL=gemini-2.5-flash
GCP_IMAGE_MODEL=imagen-4.0-generate-001
GCP_TIMEOUT_MS=90000
GCP_MAX_OUTPUT_TOKENS=2048
GCP_TEMPERATURE=0.6

# ── LOCAL MODELS · removed ────────────────────────────────────────────────
# Ollama has been removed. Text generation (captions, calendar copy, rewrites,
# the assistant) runs on Gemini via the GCP_* keys above, with the deterministic
# template writer as the floor when no Google credential is set.

# Which binding the Python agents run on: `anthropic`, `deterministic`, or
# `auto`. `auto` and `anthropic` both use Claude when ANTHROPIC_API_KEY is set;
# `deterministic` attempts nothing and is a positive choice, not a failure.
# Whichever binding answers is stamped on the result.
AGENT_MODEL_PROVIDER=auto            # auto | anthropic | deterministic

# ── IDENTITY AND ROLE ─────────────────────────────────────────────────────
# The two-approval rule is enforced on the SERVER, not in the UI: the marketing
# approval route requires the marketing role and the leadership route requires
# leadership, so one account cannot supply both signatures.
#
# OPERATOR_PASSWORD blank means NO PASSWORD IS REQUIRED — the product must run
# with an empty environment, so an absent credential opens the gate rather than
# closing the product. /api/health reports `auth.enforced` so an open gate is
# visible instead of assumed shut. Set it for anything reachable by others.
#
# SESSION_SECRET signs the session cookie. Blank means a random per-process key,
# so sessions end when the API restarts — inconvenient and safe. There is
# deliberately no shipped default: a constant would mean every deployment shared
# a signing key, and anyone could mint a leadership cookie.
#
# SESSION_SECURE_COOKIE marks the cookie `Secure`. Leave false for plain-HTTP
# localhost, where a Secure cookie would never be stored and sign-in would
# appear to silently fail. Turn it on behind TLS.
OPERATOR_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
SESSION_SECURE_COOKIE=false

# ── THE PYTHON AGENT TIER · process boundary ──────────────────────────────
# The eight Python agents run as a spawned sidecar (`backend/api.py`), so the
# interpreter is deployment configuration — the same kind of key as
# CRAWL4AI_PYTHON, and reported at /api/health beside it.
#
# Both blank is the normal case: the interpreter resolves to `<repo>/backend/
# .venv/bin/python`, derived from the server's own module location rather than
# the working directory, so it resolves the same whether the API was started from
# the repo root or from server/.
#
# Set AGENT_PYTHON to point at an interpreter elsewhere — a shared venv, a
# pyenv shim. Set AGENT_BACKEND_ROOT when `api.py` and `.venv` live outside the
# repo. A relative value is resolved against the repo root, never the cwd.
# A path that does not exist is refused before anything spawns, with the key and
# the fix named — rather than surfacing as an agent run that produces no frames.
AGENT_PYTHON=
AGENT_BACKEND_ROOT=

# ── SEMANTIC RETRIEVAL · embeddings (pgvector) ────────────────────────────
# The Knowledge Base and every scraped page are stored WITH a vector, so
# retrieval finds meaning as well as wording — "RLHF" reaches an entry that only
# ever says "reinforcement learning from human feedback".
#
# It rides the same Google credential as Gemini text (GCP_API_KEY or
# GCP_SERVICE_ACCOUNT_JSON above), so it needs no extra service or key. The model
# is gemini-embedding-001, requested at 768 dimensions and L2-normalised.
#
# Requires the pgvector extension. Homebrew: `brew install pgvector`.
# Docker: use the pgvector/pgvector:pg17 image rather than postgres:17-alpine.
#
# With no Google credential, or with EMBEDDINGS_ENABLED=false, retrieval falls
# back to the lexical scorer with the reason stated on the result. Nothing is
# lost: rows still store, they simply keep a NULL vector until `npm run db:embed`
# reaches them.
#
# EMBEDDING_DIMENSIONS is a CHECK, not a free setting. schema.sql fixes the
# column at vector(768) because pgvector needs a literal width for its HNSW
# index, and gemini-embedding-001 returns exactly this width when asked. A
# response of a different width is refused at the boundary. Changing it means
# changing schema.sql too and re-embedding everything.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=120000

# ── IMAGE MODEL · FLUX.2 Klein on MLX (mflux) ────────────────────────────
# mflux is the transport that paints FLUX.2 Klein, run as a subprocess on this
# machine. Blank MFLUX_PYTHON ⇒ the painter falls back to the local brand
# renderer with a stated reason.
#   python3.12 -m venv .mflux-venv && .mflux-venv/bin/pip install mflux==0.19.1
# MFLUX_PYTHON must point at that venv's interpreter; the CLI is found beside it.
MFLUX_PYTHON=                        # e.g. /abs/path/.mflux-venv/bin/python
# flux2-klein-4b is Apache-2.0 and ungated. flux2-klein-9b is a gated
# Hugging Face repo under the FLUX non-commercial licence: accept the terms and
# set HF_TOKEN before naming it here.
MFLUX_MODEL=flux2-klein-4b
MFLUX_STEPS=4                        # Klein is distilled; four steps is the point
MFLUX_SEED=42                        # fixed, so a brief renders the same twice
MFLUX_QUANTIZE=8
MFLUX_TIMEOUT_MS=900000              # the first run also downloads weights

# ── SCRAPING · Claude Bridge (every lane) ───────────────────────────────
# All Scraping Agent capture — LinkedIn, Instagram, X, Facebook and the open web —
# is the Claude Bridge (server/src/bridges/claude-bridge/). It drives Claude Code
# headlessly with its WebSearch tool only, keeps only real post URLs from the raw
# search results, and dates each item from what the platform or page states.
# Facebook posts cannot be dated, so that lane skips itself in capture.
# Credentials are Claude Code's own login — nothing is stored here.
#
# Blank CLAUDE_CODE_BIN ⇒ `claude` on PATH, then ~/.claude/local/claude, then
# the binary bundled with the VS Code extension. Set it to pin one.
CLAUDE_CODE_BIN=
CLAUDE_BRIDGE_MODEL=                 # blank ⇒ bridge.config.json (sonnet)
# Limits and weights live in server/src/bridges/claude-bridge/config/bridge.config.json.
# These override the most-changed ones per deployment:
LINKEDIN_TRENDS_WINDOW_DAYS=
LINKEDIN_TRENDS_MAX_KEYWORDS=
LINKEDIN_TRENDS_MAX_QUERIES_PER_KEYWORD=
LINKEDIN_TRENDS_MAX_RESULTS_PER_QUERY=
LINKEDIN_TRENDS_MAX_TOTAL_QUERIES=
LINKEDIN_TRENDS_RESULT_LIMIT=
LINKEDIN_TRENDS_MIN_RELEVANCE=       # high | medium | low
LINKEDIN_TRENDS_ADAPTERS=            # comma list: claude_code,sma_captures,manual_urls
LINKEDIN_TRENDS_MANUAL_URLS_FILE=    # JSON list of post URLs an operator maintains
LINKEDIN_TRENDS_KB_FILE=             # force a Knowledge Base file instead of the database
LINKEDIN_TRENDS_LOG_FILE=            # e.g. logs/claude-bridge.jsonl — one line per execution
LINKEDIN_TRENDS_CONFIG=              # alternative bridge.config.json

# ── IMAGE MODEL (optional secondary renderer) ────────────────────────────
Z_IMAGE_ENDPOINT=
Z_IMAGE_API_KEY=
Z_IMAGE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo
Z_IMAGE_TIMEOUT_MS=60000

# ── TRANSCRIPTION · Whisper, a local sidecar (ADR-011) ───────────────────
# Turns a captured reel's actual words into evidence. Runs LOCALLY rather than
# through a hosted API, so the cost is wall-clock time on this machine and not
# an invoice a slider can run up.
#
# BLANK IS A SUPPORTED CONFIGURATION AND IS THE DEFAULT. With WHISPER_PYTHON
# unset nothing spawns, `scraped_items.transcript` stays NULL, and the run says
# what it could not transcribe. NULL means NOT TRANSCRIBED; an empty string
# would mean the transcriber ran and heard nothing, and those are different
# facts that nothing downstream may collapse.
#
# To enable it:
#   python3 -m venv .venv-whisper
#   .venv-whisper/bin/pip install faster-whisper
#   WHISPER_PYTHON=.venv-whisper/bin/python
WHISPER_PYTHON=                      # e.g. /abs/path/.venv-whisper/bin/python
WHISPER_MODEL=base                   # tiny | base | small | medium | large-v3
WHISPER_LANGUAGE=auto                # 'auto' detects per item; pinning is faster and can be wrong

# The two ceilings. The
# operator's knob (`transcriptMaxMinutesPerRun`) asks, and this decides. The run
# says so in its log when the clamp actually binds — a slider that silently
# stopped mattering is worse than one that is absent.
WHISPER_MAX_MINUTES_PER_RUN=20       # total audio one run may transcribe
WHISPER_MAX_SECONDS_PER_ITEM=600     # bounds ONE item, so a long stream cannot eat the run budget
WHISPER_TIMEOUT_MS=180000            # one item, model load included
