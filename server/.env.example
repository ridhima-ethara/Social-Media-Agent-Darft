# ── Core ─────────────────────────────────────────────────────────────────
# `ethara_socialai` is what docker-compose.yml creates (POSTGRES_DB), and what
# config.ts defaults to. The three agree deliberately: they used to say
# `ethara_sma` here, so copying this file gave you a URL pointing at a database
# nothing had created, and the API refused to start without explaining why.
DATABASE_URL=postgresql://ethara:ethara@localhost:5432/ethara_socialai
# 4001, not 4000: another project answers on :4000 with a different API. The Vite
# dev proxy and the container's nginx both read this same port.
PORT=4001
WORKSPACE_SLUG=ethara
CORS_ORIGIN=*
TZ=Asia/Kolkata
# 'demo' simulates every platform call. 'live' requires real credentials.
PUBLISH_MODE=demo

# ── Ethara · command plane ───────────────────────────────────────────────
# The reasoning model behind intent parsing, planning and narration.
# Leave ASSISTANT_MODEL_PROVIDER blank (or 'deterministic') and Ethara runs on the
# built-in grammar parser + template narrator: slightly blunter, fully working.
ASSISTANT_MODEL_PROVIDER=            # gcp | ollama | deterministic
ASSISTANT_PLANNER_MODEL=gemini-2.5-pro
ASSISTANT_NARRATOR_MODEL=gemini-2.5-flash
ASSISTANT_MAX_PLAN_STEPS=8
ASSISTANT_CONFIRM_TTL_SECONDS=180
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_BRIEF_CRON=0 9 * * 1-5     # weekday 09:00 proactive briefing
ASSISTANT_WATCH_INTERVAL_MS=60000    # ambient anomaly sweep
ASSISTANT_VOICE_ENABLED=true         # server hint only; the browser decides
ASSISTANT_ADDRESS_STYLE=surname      # surname | firstname | role

# ── KNOWLEDGE · Parallel Web Systems (deep research) ─────────────────────
# Blank PARALLEL_API_KEY ⇒ the Knowledge Agent reads the open web with crawl4ai
# instead. There is no bundled research corpus: an uncited claim never enters
# the Knowledge Base, so there is nothing to substitute when neither answers.
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_SEARCH_PATH=/v1beta/search
PARALLEL_TASK_PATH=/v1/tasks/runs
PARALLEL_PROCESSOR=base
PARALLEL_MAX_RESULTS=10
PARALLEL_MAX_CHARS_PER_RESULT=6000
PARALLEL_TIMEOUT_MS=120000
KNOWLEDGE_BUILD_CRON=0 6 * * 0    # Sunday 06:00 in TZ
KNOWLEDGE_HASHTAG_COUNT=25

# ── CONTENT · Google Cloud (Gemini / Vertex / Imagen) ────────────────────
# Blank ⇒ the deterministic template writer. Never blocks the pipeline.
GCP_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON=
GCP_TEXT_MODEL=gemini-2.5-pro
GCP_FAST_TEXT_MODEL=gemini-2.5-flash
GCP_IMAGE_MODEL=imagen-4.0-generate-001
GCP_TIMEOUT_MS=90000
GCP_MAX_OUTPUT_TOKENS=2048
GCP_TEMPERATURE=0.6

# ── LOCAL MODELS · Ollama (Qwen3 text, FLUX.2 Klein images) ──────────────
# Blank OLLAMA_BASE_URL ⇒ Ollama is treated as absent. There is no default on
# purpose: a default would make /health claim a live local model on a machine
# with no daemon running.
#   ollama serve
#   ollama pull qwen3.5           # text: every reasoning agent
#   ollama pull x/flux2-klein     # images: backgrounds only, brand layer is local
#
# A tag that is not pulled is not a fallback — Ollama answers 404 and the agent
# degrades to its deterministic path, so these must name models `ollama list`
# actually shows.
OLLAMA_BASE_URL=                     # e.g. http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3.5:latest
OLLAMA_FAST_TEXT_MODEL=qwen3.5:latest
OLLAMA_IMAGE_MODEL=x/flux2-klein:latest
OLLAMA_TIMEOUT_MS=180000             # local generation is slower per token
OLLAMA_IMAGE_TIMEOUT_MS=600000
OLLAMA_CONTEXT_TOKENS=16384          # tool results are truncated to fit this

# Which binding the eight Python agents run on: `ollama`, `anthropic`,
# `deterministic`, or `auto`. Naming it rather than leaving `auto` keeps the
# choice on the record — `auto` silently follows whichever key happens to be
# present, and "which model produced this" is the first question asked of any
# agent output.
#
# The named provider is the PRIMARY, not the only one. If it is unreachable the
# other configured binding is tried behind it, and only then does the run fall
# to the deterministic pipeline. Whichever binding answers is stamped on the
# result, and a backup that stood in names what it stood in for — so a rotated
# credential is visible rather than hidden behind a working fallback.
# `deterministic` attempts nothing: it is a positive choice, not a failure.
AGENT_MODEL_PROVIDER=ollama

# Which vendor writes captions, phrases calendar ideas and rewrites drafts.
#
# This is a CHAIN, primary first, exactly as a platform capture lane is Apify
# then crawl4ai:
#   gcp     Gemini first, the local Qwen behind it
#   ollama  Qwen first, Gemini behind it
#   auto    the local model first — it costs nothing per call and keeps
#           evidence on the machine — with the hosted one behind it
#
# The backup is only entered when the primary is configured AND fails; with one
# provider configured the chain is one link and a failure goes straight to the
# deterministic template writer. /api/health reports the resolved chain.
#
# For Gemini-primary with Qwen as the backup, set this to `gcp` and supply
# GCP_API_KEY (or GCP_SERVICE_ACCOUNT_JSON) above plus OLLAMA_BASE_URL below.
TEXT_MODEL_PROVIDER=auto             # auto | ollama | gcp

# ── IDENTITY AND ROLE ─────────────────────────────────────────────────────
# The two-approval rule is enforced on the SERVER, not in the UI: the marketing
# approval route requires the marketing role and the leadership route requires
# leadership, so one account cannot supply both signatures.
#
# OPERATOR_PASSWORD blank means NO PASSWORD IS REQUIRED — the product must run
# with an empty environment, so an absent credential opens the gate rather than
# closing the product. /api/health reports `auth.enforced` so an open gate is
# visible instead of assumed shut. Set it for anything reachable by others.
#
# SESSION_SECRET signs the session cookie. Blank means a random per-process key,
# so sessions end when the API restarts — inconvenient and safe. There is
# deliberately no shipped default: a constant would mean every deployment shared
# a signing key, and anyone could mint a leadership cookie.
#
# SESSION_SECURE_COOKIE marks the cookie `Secure`. Leave false for plain-HTTP
# localhost, where a Secure cookie would never be stored and sign-in would
# appear to silently fail. Turn it on behind TLS.
OPERATOR_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
SESSION_SECURE_COOKIE=false

# ── THE PYTHON AGENT TIER · process boundary ──────────────────────────────
# The eight Python agents run as a spawned sidecar (`backend/api.py`), so the
# interpreter is deployment configuration — the same kind of key as
# CRAWL4AI_PYTHON, and reported at /api/health beside it.
#
# Both blank is the normal case: the interpreter resolves to `<repo>/backend/
# .venv/bin/python`, derived from the server's own module location rather than
# the working directory, so it resolves the same whether the API was started from
# the repo root or from server/.
#
# Set AGENT_PYTHON to point at an interpreter elsewhere — a shared venv, a
# pyenv shim. Set AGENT_BACKEND_ROOT when `api.py` and `.venv` live outside the
# repo. A relative value is resolved against the repo root, never the cwd.
# A path that does not exist is refused before anything spawns, with the key and
# the fix named — rather than surfacing as an agent run that produces no frames.
AGENT_PYTHON=
AGENT_BACKEND_ROOT=

# ── SEMANTIC RETRIEVAL · embeddings (pgvector) ────────────────────────────
# The Knowledge Base and every scraped page are stored WITH a vector, so
# retrieval finds meaning as well as wording — "RLHF" reaches an entry that only
# ever says "reinforcement learning from human feedback".
#
# It rides the Ollama daemon above, so it needs no extra service, key or egress:
#   ollama pull nomic-embed-text
#
# Requires the pgvector extension. Homebrew: `brew install pgvector`.
# Docker: use the pgvector/pgvector:pg17 image rather than postgres:17-alpine.
#
# Unset OLLAMA_BASE_URL, or set EMBEDDINGS_ENABLED=false, and retrieval falls
# back to the lexical scorer with the reason stated on the result. Nothing is
# lost: rows still store, they simply keep a NULL vector until `npm run db:embed`
# reaches them.
#
# EMBEDDING_DIMENSIONS is a CHECK, not a setting. schema.sql fixes the column at
# vector(768) because pgvector needs a literal width for its HNSW index, so a
# model of a different width is refused at the boundary rather than failing
# inside a distance operator. Changing embedder means changing both and running
# `npm run db:embed` to re-embed everything.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=120000

# ── IMAGE MODEL · FLUX.2 Klein on MLX (mflux) ────────────────────────────
# Ollama 0.33.3 refuses image models over HTTP — `/api/generate` answers
# "image generation models are not currently supported" — so mflux is the
# transport that actually paints. The painter tries Ollama first regardless,
# and will switch over on its own once Ollama exposes image generation.
#   python3.12 -m venv .mflux-venv && .mflux-venv/bin/pip install mflux==0.19.1
# MFLUX_PYTHON must point at that venv's interpreter; the CLI is found beside it.
MFLUX_PYTHON=                        # e.g. /abs/path/.mflux-venv/bin/python
# flux2-klein-4b is Apache-2.0 and ungated. flux2-klein-9b is a gated
# Hugging Face repo under the FLUX non-commercial licence: accept the terms and
# set HF_TOKEN before naming it here.
MFLUX_MODEL=flux2-klein-4b
MFLUX_STEPS=4                        # Klein is distilled; four steps is the point
MFLUX_SEED=42                        # fixed, so a brief renders the same twice
MFLUX_QUANTIZE=8
MFLUX_TIMEOUT_MS=900000              # the first run also downloads weights

# ── SCRAPING · Apify (the four platform lanes) ───────────────────────────
# WHY THIS IS WORTH PAYING FOR. An actor reads the platform itself and returns
# real reaction, comment and share counts. Three of the Validation Agent's four
# trend components — engagement (35), velocity (20), growth (20) — are
# engagement maths, so without stated figures 75 of the 100 points of
# trend_score are inert and keywords rank on post volume alone.
#
# Token: https://console.apify.com/settings/integrations — sent as
# `Authorization: Bearer`, never in the query string (https://apify.com/agents.md).
# Blank ⇒ the platform lanes degrade to crawl4ai: the same five lanes still run,
# reading search-indexed pages, stamped metricsAvailable=false. No fixtures.
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2

# One actor per lane. All four are keyless (no cookies or login) and bill per
# result. Swapping one is a config change — the request body is built per actor
# FAMILY in integrations/apify.ts, so a same-family actor drops straight in.
#   linkedin   ~$2.00/1k   engagement.likes / .comments / .shares
#   instagram  ~$2.60/1k   likesCount / commentsCount — no recency filter at all
#   x          ~$0.40/1k   likeCount / retweetCount / replyCount / quoteCount
#   facebook   ~$4.00/1k   reactionsCount / commentsCount / sharesCount
APIFY_LINKEDIN_POSTS_ACTOR=harvestapi~linkedin-post-search
APIFY_INSTAGRAM_ACTOR=apify~instagram-hashtag-scraper
APIFY_X_ACTOR=apidojo~tweet-scraper
APIFY_FACEBOOK_ACTOR=scraper_one~facebook-posts-search

APIFY_RUN_TIMEOUT_MS=180000          # sync window; doubled for the async fallback
# The ceiling the operator's knob cannot exceed. Cost is
# keywords x platform lanes x this — 5 keywords x 4 lanes x 50 is ~1,000
# results, roughly $2.25 a run at the rates above.
APIFY_MAX_ITEMS_PER_KEYWORD=50
APIFY_MEMORY_MBYTES=1024

# ── SCRAPING · crawl4ai (keyless, the open-web lane) ─────────────────────
# The fifth lane, and the only one Apify has no actor for: an unscoped read of
# the web at large, which is where the substantive material usually is. Also
# the fallback for the four platform lanes when APIFY_API_TOKEN is blank.
# A search-indexed page states no reaction count, so everything captured here
# carries metricsAvailable=false and is excluded from the engagement, velocity
# and growth components rather than counted as zero.
# Leave CRAWL4AI_PYTHON blank and the open-web lane cannot run.
#   backend/.venv/bin/pip install -r backend/requirements.txt
#   backend/.venv/bin/python -m playwright install chromium
CRAWL4AI_PYTHON=                     # e.g. /abs/path/backend/.venv/bin/python
CRAWL4AI_SEARCH_ENGINES=duckduckgo,bing
CRAWL4AI_MAX_PAGES_PER_KEYWORD=6  # per keyword; caps the open-web lane's browser loads
CRAWL4AI_MAX_CHARS_PER_PAGE=6000
CRAWL4AI_TIMEOUT_MS=300000           # one lane's crawl, browser start included
CRAWL4AI_DELAY_MS=400                # politeness between fetches
CRAWL4AI_HEADLESS=true

# ── IMAGE MODEL (optional secondary renderer) ────────────────────────────
Z_IMAGE_ENDPOINT=
Z_IMAGE_API_KEY=
Z_IMAGE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo
Z_IMAGE_TIMEOUT_MS=60000
