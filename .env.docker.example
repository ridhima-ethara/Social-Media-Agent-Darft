# Compose configuration for the on-prem stack.
#
#   cp .env.docker.example .env
#
# This file configures the CONTAINERS. It is not `server/.env` and must not be
# copied from it: that file points at host paths (a macOS venv, localhost:11434)
# which do not exist inside a container.
#
# Every key here has a working default in docker-compose.yml. Set only what you
# need to change.

# ── Where the app answers ────────────────────────────────────────────────
# THE ONE PUBLISHED PORT. Everything else — the API, Postgres, Ollama — talks
# on the compose network and is not reachable from outside the host. Share this
# one: http://<this-machine-ip>:8080
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080

# ── Database ─────────────────────────────────────────────────────────────
# Change the password before anything leaves your laptop. The database is not
# published to the host, but "not published" is not the same as "safe".
POSTGRES_USER=ethara
# CHANGE THIS. It is the development default, and the database is reachable by
# every container on the compose network.
POSTGRES_PASSWORD=ethara
POSTGRES_DB=ethara_socialai

# ── Workspace ────────────────────────────────────────────────────────────
WORKSPACE_SLUG=ethara
TZ=Asia/Kolkata

# `demo` writes publish receipts without calling a platform. `live` requires
# real platform credentials AND is refused unless set here explicitly — the
# Publisher checks this at the point of no return, not at startup.
PUBLISH_MODE=demo

# ── Scraping · the four platform lanes ───────────────────────────────────
# Blank ⇒ the platform lanes fall back to crawl4ai and read search-indexed
# pages, which state no engagement. Three of the four trend components are
# engagement maths, so without this the ranking runs on post volume alone.
# Token: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Cost ceiling the Agent Studio slider cannot exceed. Roughly
# keywords x lanes x this results per run — 5 x 4 x 50 is ~1,000, about $2.25.
APIFY_MAX_ITEMS_PER_KEYWORD=50

# ── Scraping · the open-web lane ─────────────────────────────────────────
# Every browser page is a real load inside the container; raise with care.
CRAWL4AI_MAX_PAGES_PER_KEYWORD=6

# ── Text model ───────────────────────────────────────────────────────────
# Default is the bundled ollama service. Two alternatives:
#
#   host Ollama (Docker Desktop, macOS/Windows):
#     OLLAMA_BASE_URL=http://host.docker.internal:11434
#   host Ollama (Linux):
#     OLLAMA_BASE_URL=http://172.17.0.1:11434
#
# On Apple Silicon the bundled service runs on CPU — Docker has no Metal
# passthrough — so pointing at host Ollama is markedly faster there.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=qwen3:14b

# Set to `deterministic` to switch the command plane off the model entirely and
# run it on the built-in grammar parser: blunter, fully working, no GPU.
ASSISTANT_MODEL_PROVIDER=ollama
TEXT_MODEL_PROVIDER=ollama

# ── First boot ───────────────────────────────────────────────────────────
# The API applies the schema and seeds the workspace on every start. Both are
# idempotent. Set RUN_SEED=false once you have real data you would rather the
# seed did not rewrite.
# ── CONTENT AND IMAGES · Gemini ───────────────────────────────────────────
# This deployment writes captions and paints creative backgrounds with Gemini.
# Two ways to authenticate; the API key wins if both are set.
#
#   GCP_API_KEY              an AI Studio key, against the public API.
#   GCP_SA_FILE + PROJECT_ID a service account, against Vertex. The JSON stays on
#                            the host and is bind-mounted read-only into the
#                            container — it is never copied into an image layer.
#
# Blank both and text falls to the local Ollama model, then to the deterministic
# template writer, and creatives fall to the local brand renderer. Every one of
# those is labelled on the card it produced.
GCP_API_KEY=

# HOST path to the service-account JSON, mounted at /run/secrets/gcp-sa.json.
GCP_SA_FILE=./server/secrets/gcp-sa.json
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_TEXT_MODEL=gemini-2.5-pro
GCP_FAST_TEXT_MODEL=gemini-2.5-flash
# A gemini-* model is served over :generateContent, an imagen-* one over
# :predict. The adapter routes on the name, so either works here.
GCP_IMAGE_MODEL=gemini-2.5-flash-image

# ── RESEARCH · Parallel Web Systems ───────────────────────────────────────
# Blank ⇒ the Knowledge Agent reads the open web with crawl4ai instead, and
# records the reason on every entry it writes.
PARALLEL_API_KEY=

RUN_MIGRATIONS=true
RUN_SEED=auto
