# ── The web app ───────────────────────────────────────────────────────────
#
# VITE_API_URL IS DELIBERATELY NOT SET.
#
# Left unset, the bundle uses the RELATIVE base `/api`, which is what makes the
# app work from whatever host served it. The Vite dev server proxies `/api` to
# the API (reading PORT from server/.env), and nginx does exactly the same thing
# in the container image — so dev and the on-prem deployment resolve the API the
# same way instead of diverging.
#
# Setting an absolute URL here breaks the moment a second device opens the app:
# `http://localhost:4001/api` on a phone means the phone. Hard-coding the LAN IP
# instead just moves the problem, because DHCP reassigns it.
#
# Set it ONLY to point the app at an API on a different origin — a shared staging
# server, say. It is an override, not part of normal setup:
#
#   VITE_API_URL=https://socialai.internal.example/api

VITE_ASSISTANT_VOICE=true
VITE_ASSISTANT_WAKE_PHRASE=assistant
